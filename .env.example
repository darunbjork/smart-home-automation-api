# Copy to .env (development) and fill in real values.
# Production values live in the Render dashboard.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Mongo connection string (Atlas in production)
MONGO_URI=mongodb://localhost:27017/smarthome

# >= 32 random characters in production. Rotate if ever exposed.
JWT_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Comma-separated exact origins, no wildcards.
# Dev: http://localhost:5173
# Prod: https://<your-pages-domain>,https://app.<your-domain>
CORS_ORIGINS=http://localhost:5173

# lax for same-site deployment (app.example.com + api.example.com).
# "none" only if truly cross-site (breaks in Safari with ITP).
COOKIE_SAMESITE=lax
# .example.com when app and API share a registrable domain; leave empty for host-only cookies.
COOKIE_DOMAIN=

# Render = 1
TRUST_PROXY_HOPS=1

DEFAULT_DEVICE_SIMULATED=true
DEVICE_ACK_TIMEOUT_MS=10000

AI_ENABLED=false
GEMINI_API_KEY=
# Current model id from Google's model list (no default on purpose)
GEMINI_MODEL=

# Broker stays off in production if MQTT_USERNAME is empty
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BIND_HOST=127.0.0.1

# Phase 9 (n8n Hearth Sentinel)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Error reporting. Empty = disabled (nothing is sent anywhere).
# Set on Render to enable; 5xx errors and unhandled crashes are reported.
SENTRY_DSN=
